{
  "manifest_version": 3,
  "name": "Multitude LLM",
  "version": "0.4.5",
  "description": "Gemini · ChatGPT · DeepSeek · Perplexity · Grok · Mistral · Qwen · Genspark · Duck.ai 웹 채팅을 한 탭에서 최대 4개까지 띄워 같은 질문을 동시에 보내고 답변을 비교합니다.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Multitude LLM 열기",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest",
    "clipboardWrite",
    "browsingData",
    "cookies"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://chat.deepseek.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://grok.com/*",
    "https://chat.mistral.ai/*",
    "https://chat.qwen.ai/*",
    "https://www.genspark.ai/*",
    "https://genspark.ai/*",
    "https://duck.ai/*",
    "https://duckduckgo.com/*",
    "wss://gemini.google.com/*",
    "wss://chatgpt.com/*",
    "wss://chat.deepseek.com/*",
    "wss://www.perplexity.ai/*",
    "wss://perplexity.ai/*",
    "wss://grok.com/*",
    "wss://chat.mistral.ai/*",
    "wss://chat.qwen.ai/*",
    "wss://www.genspark.ai/*",
    "wss://genspark.ai/*",
    "wss://duck.ai/*",
    "wss://duckduckgo.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://chat.deepseek.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://grok.com/*",
        "https://chat.mistral.ai/*",
        "https://chat.qwen.ai/*",
        "https://www.genspark.ai/*",
        "https://genspark.ai/*",
        "https://duck.ai/*",
        "https://duckduckgo.com/*"
      ],
      "js": [
        "lib/shared/page.js",
        "lib/shared/markdown.js",
        "lib/shared/shortcuts.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.qwen.ai/*"
      ],
      "js": [
        "cookie-shim.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chat.qwen.ai/*"
      ],
      "js": [
        "cookie-bridge.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
