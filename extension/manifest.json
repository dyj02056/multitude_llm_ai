{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "0.28.0",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "open-side-panel": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_cmdSidePanel__"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest",
    "clipboardWrite",
    "browsingData",
    "cookies",
    "contextMenus",
    "activeTab",
    "scripting",
    "sidePanel",
    "notifications"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://grok.com/*",
    "https://chat.mistral.ai/*",
    "https://chat.qwen.ai/*",
    "https://auth.qwen.ai/*",
    "https://chat.z.ai/*",
    "https://www.genspark.ai/*",
    "https://genspark.ai/*",
    "https://duck.ai/*",
    "https://duckduckgo.com/*",
    "wss://gemini.google.com/*",
    "wss://chatgpt.com/*",
    "wss://claude.ai/*",
    "wss://chat.deepseek.com/*",
    "wss://www.perplexity.ai/*",
    "wss://perplexity.ai/*",
    "wss://grok.com/*",
    "wss://chat.mistral.ai/*",
    "wss://chat.qwen.ai/*",
    "wss://auth.qwen.ai/*",
    "wss://chat.z.ai/*",
    "wss://www.genspark.ai/*",
    "wss://genspark.ai/*",
    "wss://duck.ai/*",
    "wss://duckduckgo.com/*"
  ],
  "optional_host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://chat.deepseek.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://grok.com/*",
        "https://chat.mistral.ai/*",
        "https://chat.qwen.ai/*",
        "https://auth.qwen.ai/*",
        "https://chat.z.ai/*",
        "https://www.genspark.ai/*",
        "https://genspark.ai/*",
        "https://duck.ai/*",
        "https://duckduckgo.com/*"
      ],
      "js": [
        "lib/shared/page.js",
        "lib/shared/markdown.js",
        "lib/shared/shortcuts.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.qwen.ai/*",
        "https://auth.qwen.ai/*"
      ],
      "js": [
        "cookie-shim.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chat.qwen.ai/*",
        "https://auth.qwen.ai/*",
        "https://chat.z.ai/*"
      ],
      "js": [
        "cookie-bridge.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
