{
  "name": "multitude-llm-ai",
  "productName": "Multitude LLM",
  "version": "0.9.3",
  "description": "Gemini · ChatGPT · Claude · DeepSeek · Perplexity · Grok · Mistral · Qwen · Z.ai · Genspark · Duck.ai 웹 채팅을 한 화면에서 최대 6개까지 동시에 쓰는 앱 — 파일 첨부, 로컬 프로젝트 코드 작업 (Windows 앱 · 크롬 확장 프로그램)",
  "author": "dyj02056",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "build:ext": "node scripts/build-extension.js",
    "check:ext": "node scripts/build-extension.js --check",
    "test": "node --test \"test/**/*.test.js\""
  },
  "build": {
    "appId": "com.dyj02056.multitudellm",
    "productName": "Multitude LLM",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Multitude LLM",
      "artifactName": "MultitudeLLM-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  }
}
